{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的基础权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "allow-quick-host",
    "autostart:default",
    "allow-desktop-lifecycle",
    "sql:allow-select",
    "sql:allow-load",
    "sql:allow-close",
    "allow-finance",
    "allow-execute-batch"
  ]
}
